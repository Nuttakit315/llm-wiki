# --- Multi-Provider API Keys (เลือกใส่ตัวใดตัวหนึ่ง หรือใส่ทั้งหมดก็ได้) ---

# 1. Google Gemini API Key (ขอฟรีได้จาก https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Anthropic Claude API Key (ขอได้จาก https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 3. OpenAI ChatGPT API Key (ขอได้จาก https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# (ทางเลือก) กำหนด Provider เจาะจง: "gemini", "claude", หรือ "openai" (ถ้าไม่ระบุ ระบบจะตรวจจับตาม Key ที่มีให้อัตโนมัติ)
LLM_PROVIDER=gemini
